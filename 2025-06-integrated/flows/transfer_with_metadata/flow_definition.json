{
  "Comment": "Transfer files to a specific endpoint with compute + transfer access, then run validation function on files in a specific location",
  "StartAt": "DefineGlobals",
  "States": {
    "DefineGlobals": {
      "Comment": "Calculate global variables that will be used across multiple steps",
      "Type": "ExpressionEval",

      "Next": "GetInfoSourcePath",
      "ResultPath": "$.meta",

      "Parameters": {
        "metadata_fn": "_globus_search_metadata.json",

        "dataset_id.=": "f'{_context.flow_id}_{_context.run_id}'",
        "dest_path.=": "f'/{_context.flow_id}_{_context.run_id}/'",

        "_pvt_user_uuid.=": "_context['user_id'].rpartition(':')[-1]",

        "_pvt_destination_id": "dba0d7c0-1f63-44d1-bcd0-76865d3d44a0",
        "_pvt_search_index_id": "a803fd20-7c86-476f-8d0a-bd92bd5ff7fa",

        "_pvt_compute_endpoint_id": "5a2456c6-6c72-4cd4-a2e3-984f2e3c1b86",
        "_pvt_compute_function_id": "6a4d6359-857c-4f6a-a40e-a778e64c3a13",

        "__Private_Parameters": [
          "_pvt_user_uuid",

          "_pvt_destination_id",
          "_pvt_search_index_id",

          "_pvt_compute_endpoint_id",
          "_pvt_compute_function_id"
        ]
      }
    },


    "GetInfoSourcePath": {
      "Type": "Action",
      "ActionUrl": "https://transfer.actions.globus.org/stat",
      "Comment": "Query source path so we can ensure it is a folder (not a file).",

      "RunAs": "User",

      "Next": "GetInfoDestPath",
      "ResultPath": "$.prev.GetInfoSourcePath",

      "ExceptionOnActionFailure": true,
      "Catch": [
        {
          "Next": "FailSetupGeneric",

          "ResultPath": "$.error",
          "ErrorEquals": [
            "ActionUnableToRun",
            "ActionFailedException",
            "ActionTimeout"
          ]
        }
      ],

      "Parameters": {
        "endpoint_id.$": "$.source.id",
        "path.$":  "$.source.path"
      }
    },


    "GetInfoDestPath": {
      "Type": "Action",
      "ActionUrl": "https://transfer.actions.globus.org/stat",
      "Comment": "Ensure that data in the destination does not yet exist",

      "RunAs": "Flow",

      "Next": "EvalSourceDest",
      "ResultPath": "$.prev.GetInfoDestPath",

      "ExceptionOnActionFailure": true,
      "Catch": [
        {
          "Next": "FailSetupGeneric",

          "ResultPath": "$.error",
          "ErrorEquals": [
            "ActionUnableToRun",
            "ActionFailedException",
            "ActionTimeout"
          ]
        }
      ],

      "Parameters": {
        "endpoint_id.$": "$.meta._pvt_destination_id",
        "path.=": "`$.meta.dest_path`"
      }
    },


    "EvalSourceDest": {
      "Type": "ExpressionEval",
      "Comment": "Calculate parameters used to decide if requirements are met",

      "Next": "CheckSourceDest",
      "ResultPath": "$.prev",

      "Parameters": {
        "source_is_dir.=": "prev.GetInfoSourcePath.details.type == 'dir'",
        "dest_exists.=": "'code' not in `$.prev.GetInfoDestPath.details` or `$.prev.GetInfoDestPath.details.code` != 'NotFound'"
      }
    },


    "CheckSourceDest": {
      "Type": "Choice",
      "Comment": "Source must be directory, dest must not exist (rule may change), and dest must allow HTTPS file access",
      "Default": "FailInvalidSourceDest",

      "Choices": [
        {
          "Next": "MakeDestDirectory",
          "And": [
            {
              "Variable": "$.prev.source_is_dir",
              "BooleanEquals": true
            },
            {
              "Variable": "$.prev.dest_exists",
              "BooleanEquals": false
            }
          ]
        }
      ]
    },


    "MakeDestDirectory": {
      "Type": "Action",
      "ActionUrl": "https://transfer.actions.globus.org/mkdir",
      "Comment": "Create the destination folder for ingest",

      "RunAs": "Flow",

      "Next": "GrantUserDestAccess",
      "ResultPath": "$.prev",

      "ExceptionOnActionFailure": true,
      "Catch": [
        {
          "Next": "FailDestinationGeneric",
          "ResultPath": "$.error",
          "ErrorEquals": [
            "ActionUnableToRun",
            "ActionFailedException",
            "ActionTimeout"
          ]
        }
      ],

      "Parameters": {
        "endpoint_id.$": "$.meta._pvt_destination_id",
        "path.$": "$.meta.dest_path"
      }
    },


    "GrantUserDestAccess": {
      "Type": "Action",
      "ActionUrl": "https://transfer.actions.globus.org/manage_permission",
      "Comment": "Grant a user temporary access to just their deposition folder. A separate script will audit this periodically.",

      "RunAs": "Flow",

      "Next": "CopyFullDatasetSourceToDest",
      "ResultPath": "$.meta.GrantUserDestAccess",

      "ExceptionOnActionFailure": true,
      "Catch": [
        {
          "Next": "FailFileCleanupBranch",

          "ResultPath": "$.error",
          "ErrorEquals": [
            "ActionUnableToRun",
            "ActionFailedException",
            "ActionTimeout"
          ]
        }
      ],

      "Parameters": {
        "principal_type": "identity",
        "principal.$": "$.meta._pvt_user_uuid",

        "operation": "CREATE",
        "permissions": "rw",

        "endpoint_id.$": "$.meta._pvt_destination_id",
        "path.$": "$.meta.dest_path"
      }
    },


    "CopyFullDatasetSourceToDest": {
      "Type": "Action",
      "ActionUrl": "https://transfer.actions.globus.org/transfer",
      "Comment": "Copy the entire dataset to destination. (wait up to 1 week in case of storage downtime mid-flow, etc)",

      "RunAs":"User",

      "Next": "RevokeUserDestAccess",
      "ResultPath": "$.prev",
      "WaitTime": 604800,

      "ExceptionOnActionFailure": true,
      "Catch": [
        {
          "Next": "FailFileCleanupBranch",
          "ResultPath": "$.error",
          "ErrorEquals": [
            "ActionUnableToRun",
            "ActionFailedException",
            "ActionTimeout"
          ]
        }
      ],

      "Parameters": {
        "source_endpoint.$": "$.source.id",
        "destination_endpoint.$": "$.meta._pvt_destination_id",
        "notify_on_succeeded": false,
        "notify_on_failed": false,
        "DATA": [
          {
            "source_path.$": "$.source.path",
            "destination_path.$": "$.meta.dest_path"
          }
        ]
      }
    },


    "RevokeUserDestAccess": {
      "Type": "Action",
      "ActionUrl": "https://transfer.actions.globus.org/manage_permission",
      "Comment": "Once a user has done the work of data transfer, revoke any further permission to read or edit this folder",

      "RunAs": "Flow",

      "Next": "WriteMetadataToDest",
      "ResultPath": "$.prev",

      "ExceptionOnActionFailure": true,
      "Catch": [
        {
          "Next": "FailFileCleanupBranch",
          "ResultPath": "$.error",

          "ErrorEquals": [
            "ActionUnableToRun",
            "ActionFailedException",
            "ActionTimeout"
          ]
        }
      ],

      "Parameters": {
        "operation": "DELETE",
        "endpoint_id.$": "$.meta._pvt_destination_id",
        "rule_id.$": "$.meta.GrantUserDestAccess.details.access_id"
      }
    },


    "WriteMetadataToDest": {
      "Type": "Action",
      "ActionUrl": "https://compute.actions.globus.org",
      "Comment": "The flow will run a compute function that saves flow input (search_metadata) to the dest location as a file",

      "RunAs": "Flow",

      "Next": "CheckWriteResult",
      "ResultPath": "$.prev",

      "ExceptionOnActionFailure": true,
      "Catch": [
        {
          "Next": "FailFileCleanupBranch",
          "ResultPath": "$.error",

          "ErrorEquals": [
            "ActionUnableToRun",
            "ActionFailedException",
            "ActionTimeout"
          ]
        }
      ],

      "Parameters": {
        "endpoint.$": "$.meta._pvt_compute_endpoint_id",
        "function.$": "$.meta._pvt_compute_function_id",

        "kwargs": {
          "collection_id.$": "$.meta._pvt_destination_id",
          "dataset_path.$": "$.meta.dest_path",

          "metadata_path.=": "f'{meta.dest_path}/{meta.metadata_fn}'",

          "identifier.$": "$.meta.dataset_id",
          "search_metadata.$": "$.search_metadata"
        },

        "__Private_Parameters": [
          "endpoint",
          "function"
        ]
      }
    },


    "CheckWriteResult": {
      "Comment": "Check that validation does not return errors. TODO: WRITE expression for is array empty",
      "Type": "Choice",

      "Default": "FailFileCleanupBranch",

      "Choices": [
        {
          "Variable": "$.prev.details.results[0].output.status",
          "StringEquals": "SUCCESS",
          "Next": "SearchIngest"
        }
      ]
    },


   "SearchIngest": {
      "Type": "Action",
      "ActionUrl": "https://actions.globus.org/search/ingest",
      "Comment": "Ingest the provided metadata into the repository search index",

      "RunAs": "Flow",

      "End": true,
      "ResultPath": "$",

      "ExceptionOnActionFailure": true,
      "Catch": [
        {
          "Next": "FailFileCleanupBranch",
          "ResultPath": "$.error",

          "ErrorEquals": [
            "ActionUnableToRun",
            "ActionFailedException",
            "ActionTimeout"
          ]
        }
      ],

      "Parameters": {
        "search_index.$": "$.meta._pvt_search_index_id",

        "subject.$": "$.meta.dataset_id",
        "content.$": "$.prev.details.results[0].output.data",

        "visible_to": [
          "public"
        ]
      }
    },


    "FailInvalidSourceDest": {
      "Type": "Fail",
      "Error": "ErrorInvalidSourceDest",
      "Cause": "Source or destination collection do not meet requirements; see logs for details"
    },


    "FailFileCleanupBranch": {
      "Type": "Action",
      "ActionUrl": "https://transfer.actions.globus.org/delete",
      "Comment": "If the flow fails for any reason, delete the data from the repository",

      "RunAs": "Flow",

      "Next": "FailDestinationGeneric",
      "ResultPath": "$.prev",


      "ExceptionOnActionFailure": true,
      "Catch": [
        {
          "Next": "FailDestinationGeneric",
          "ErrorEquals": [
            "ActionUnableToRun",
            "ActionFailedException",
            "ActionTimeout"
          ]
        }
      ],

      "Parameters": {
        "endpoint.$": "$.meta._pvt_destination_id",
        "recursive": true,

        "DATA": [
          {
            "path.$": "$.meta.dest_path"
          }
        ]
      }
    },


    "FailSetupGeneric":{
      "Type": "Fail",
      "Error": "FailDestinationGeneric",
      "Cause": "An error occurred while checking the source or destination collections"
    },


    "FailDestinationGeneric": {
      "Type": "Fail",
      "Error": "FailDestinationGeneric",
      "Cause": "An error occurred while handling data at the destination. Search metadata was not ingested."
    }
  }
}